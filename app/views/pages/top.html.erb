<div class="top-hero">
  <%= image_tag "tsun-doku_top.png",
    alt: "Tsun-doku。本の状態「積んでる・読んでる・読んだ」を記録し、読了を積み上げていくアプリ",
    style: "display: block; max-width: 100%; height: auto; margin: 0 auto;",
    class: "top-hero_image" %>
  <nav class="top-hero_actions" aria-label="アカウント">
    <%= link_to "ログイン",
        new_user_session_path,
        class: "top-button top-button--login" %>
    <%= link_to "新規登録",
        new_user_registration_path,
        class: "top-button top-button--signup" %>
  </nav>
</div>
