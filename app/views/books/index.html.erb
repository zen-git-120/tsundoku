<% content_for :title, "自分の本棚 | Tsun-doku" %>

<main class="container py-5">
    <h1 class="h2 mb-3">自分の本棚</h1>


    <p class="text-secondary">
        積んでいる本も、読みかけの本も、自分のペースで記録しよう。
    </p>

    <%= link_to "本を登録", new_book_path, class: "btn btn-primary mb-4" %>

    <section class="border rounded p-4">
        <h2 class="h5">本の一覧</h2>

        <% if @books.any? %>
          <% status_labels = {
            "unread" => "積んでる",
            "reading" => "読んでる",
            "finished" => "読んだ"
           } %>

            <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 list-unstyled">
              <% @books.each do |book| %>
                <li class="col">
                  <article class="card h-100">
                    <div class="card-body d-flex flex-column">
                      <h3 class="h5 card-title text-break"><%= book.title %></h3>

                      <p>
                        <span class="badge text-bg-secondary">
                          <%= status_labels[book.status] %>
                        </span>
                      </p>

                      <div class="d-flex gap-2 mt-auto">
                        <%= link_to "編集",
                                    edit_book_path(book),
                                    class: "btn btn-outline-secondary btn-sm" %>

                        <%= button_to "削除",
                                book_path(book),
                                method: :delete,
                                form: {
                                  data: {
                                    turbo_confirm: "この本を削除しますか？削除すると戻せません。"
                                  }
                                },
                                class: "btn btn-outline-danger btn-sm" %>
                      </div>
                    </div>
                  </article>
                </li>
              <% end %>
            </ul>
        <% else %>
          <p class="text-secondary mb-0">
             まだ本が登録されていません。「本を登録」から追加しましょう。
          </p>
        <% end %>
    </section>
</main>   


