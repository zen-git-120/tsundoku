<% content_for :title, "自分の本棚 | Tsun-doku" %>

<main class="container py-5">
    <h1 class="h2 mb-3">自分の本棚</h1>


    <p class="text-secondary">
        積んでいる本も、読みかけの本も、自分のペースで記録しよう。
    </p>

    <%= link_to "本を登録", new_book_path, class: "btn btn-primary mb-4" %>

    <section class="border rounded p-4">
        <h2 class="h5">本の一覧</h2>

        <% if @books.any? %>
          <% status_labels = {
            "unread" => "積んでる",
            "reading" => "読んでる",
            "finished" => "読んだ"
           } %>

           <% status_colors = {
              "unread" => "text-bg-danger",
              "reading" => "text-bg-warning",
              "finished" => "text-bg-success"
            } %>

            <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 list-unstyled">
              <% @books.each do |book| %>
                <li class="col">
                  <article class="card h-100">
                    <div class="card-body d-flex flex-column">
                      <h3 class="h5 card-title text-break"><%= book.title %></h3>

                      <p>
                        <span class="badge <%= status_colors[book.status] %>">
                          <%= status_labels[book.status] %>
                        </span>
                      </p>

                      <p class="small text-secondary">
                        登録日時：<%= book.created_at.strftime("%Y/%m/%d %H:%M") %>
                      </p>

                      <div class="d-flex gap-2 mt-auto">
                        <%= link_to "編集",
                                    edit_book_path(book),
                                    class: "btn btn-outline-secondary btn-sm" %>

                        <%= button_to "削除",
                                book_path(book),
                                method: :delete,
                                form: {
                                  data: {
                                    turbo_confirm: "この本を削除しますか？削除すると戻せません。"
                                  }
                                },
                                class: "btn btn-outline-danger btn-sm" %>
                      </div>
                    </div>
                  </article>
                </li>
              <% end %>
            </ul>
        <% else %>
          <p class="text-secondary mb-0">
             まだ本が登録されていません。「本を登録」から追加しましょう。
          </p>
        <% end %>
        <% if @total_pages > 1 %>
          <nav aria-label="本棚のページ切り替え" class="mt-4">
            <ul class="pagination justify-content-center flex-wrap gap-1 mb-0">
              <% if @current_page > 1 %>
                <li class="page-item">
                  <%= link_to "前へ",
                              books_path(page: @current_page - 1),
                              class: "page-link" %>
                </li>
              <% else %>
                <li class="page-item disabled">
                  <span class="page-link" aria-disabled="true">前へ</span>
                </li>
              <% end %>

              <% (1..@total_pages).each do |page_number| %>
                <% if page_number == @current_page %>
                  <li class="page-item active">
                    <span class="page-link" aria-current="page">
                      <%= page_number %>
                    </span>
                  </li>
                <% else %>
                  <li class="page-item">
                    <%= link_to page_number,
                                books_path(page: page_number),
                                class: "page-link" %>
                  </li>
                <% end %>
              <% end %>

              <% if @current_page < @total_pages %>
                <li class="page-item">
                  <%= link_to "次へ",
                              books_path(page: @current_page + 1),
                              class: "page-link" %>
                </li>
              <% else %>
                <li class="page-item disabled">
                  <span class="page-link" aria-disabled="true">次へ</span>
                </li>
              <% end %>
            </ul>
          </nav>
        <% end %>
    </section>
</main>   


