<% content_for :title, "本を登録 | Tsun-doku" %>

<main class="container py-5">
    <h1 class="h2 mb-3">本を登録</h1>

    <p class="text-secondary">
      タイトルと読書状態を入力して、本棚に追加しましょう。
    </p>

    <%= form_with model: @book do |form| %>
      <% if @book.errors.any? %>
        <div class="alert alert-danger" role="alert">
          <p class="mb-1">入力内容を確認してください。</p>
          <ul class="mb-0">
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
    <% end %>
      <div class="mb-3" >
        <%= form.label :title, "タイトル", class: "form-label" %>
        <%= form.text_field :title, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :status, "読書状態", class: "form-label" %>
        <%= form.select :status,
                        [["積んでる", "unread"],
                         ["読んでる", "reading"],
                         ["読んだ", "finished"]],
                         {},
                         class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= form.submit "登録", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= link_to "本棚に戻る", books_path, class:"btn btn-secondary" %>
</main>